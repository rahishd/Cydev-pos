# PostgreSQL connection string (Neon). Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Vercel Blob token (for product images / attachments) — from Vercel project > Storage > Blob
BLOB_READ_WRITE_TOKEN=""

# Used only by prisma/seed.ts to create the first Owner account
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@shop.local"
SEED_OWNER_PASSWORD="changeme123"

# Hamro Patro calendar API (server-side only; never prefix with NEXT_PUBLIC_)
HAMRO_PATRO_API_URL=
HAMRO_PATRO_API_KEY=
